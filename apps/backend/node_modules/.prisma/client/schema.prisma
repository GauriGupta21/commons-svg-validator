generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model UploadJob {
  id String @id @default(cuid())

  originalName  String
  optimizedName String?

  status String

  originalSize  Int
  optimizedSize Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ValidationReport {
  id String @id @default(cuid())

  uploadJobId String

  severity String
  message  String
  rule     String

  createdAt DateTime @default(now())
}
